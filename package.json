{
  "name": "@levex/levexx",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node -r ts-node/register apps/api/src/index.ts",
    "start:worker": "node -r ts-node/register apps/worker/src/index.ts",
    "db:migrate": "node-pg-migrate up -m packages/infrastructure/database/migrations",
    "db:migrate:down": "node-pg-migrate down -m packages/infrastructure/database/migrations",
    "ci": "npm ci && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "architecture:check": "node scripts/verify-architecture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "node-pg-migrate": "^7.0.0",
    "prettier": "^2.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "pg": "^8.23.0"
  }
}
